# Root .gitignore for pbl_project (Node monorepo: backend + frontend)

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment files
.env
.env.*.local

# Build outputs
/dist/
/dist-ssr/
/build/
/out/
/coverage/
.cache/
.parcel-cache/

# Logs
/logs
*.log

# Uploaded user files (do not commit uploads)
/uploads/
/backend/uploads/
/backend/public/invoices/

# OS and editor files
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.sw?

# Misc
*.local
*.pid
*.seed

# Optional caches
# Caches and temporary files
/.turbo/
/.next/
*.mjs
/backend/scratch/
