# MSME-360 Backend — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the `.env` file — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get this from: MongoDB Atlas → Connect → Drivers → Node.js
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/msme360
MONGO_URI=your_mongodb_atlas_connection_string_here

# ── JSON Web Token ────────────────────────────────────────────────────────────
# Use a long random string (e.g. openssl rand -hex 64)
JWT_SECRET=your_super_secret_jwt_key_here

# ── Groq (LLM) ────────────────────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Google Sheets Service Account ─────────────────────────────────────────────
# Create a Service Account in Google Cloud Console:
# IAM & Admin → Service Accounts → Create → Download JSON key
# Then grant the service account Editor access to the spreadsheet.
#
# From the downloaded JSON, copy these three values:
GOOGLE_PROJECT_ID=your_google_project_id
GOOGLE_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
# IMPORTANT: Paste the private_key value exactly as-is. The \n newlines are handled in code.
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour_private_key_here\n-----END RSA PRIVATE KEY-----\n"

# ── Gemini API (reserved for future use) ──────────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here
