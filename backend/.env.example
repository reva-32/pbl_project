# MSME-360 Backend Environment Variables
# 
# For Docker deployment: copy this to `./.env` and set real values.
# The `docker-compose.yml` reads these via `${VAR}` syntax.
# Do NOT commit real secrets; keep them in your host secret manager.

# (rest of file unchanged)

# Server Configuration
PORT=5001
JWT_SECRET=your_super_secret_jwt_key
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/msme360

# AI Services
GROQ_API_KEY=gsk_your_groq_api_key

# Google Cloud (Sheets & Service Account)
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Note: Ensure the private key is wrapped in quotes and includes \n for newlines if setting via dashboard.
# Alternative to the two values above:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ── Channel integrations ─────────────────────────────────────────────────────
# AES-256-GCM key used to encrypt provider tokens at rest. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store it in the host's secret manager. Never commit a real value.
INTEGRATION_ENCRYPTION_KEY=replace-with-64-hex-characters

# Gmail OAuth (the older GMAIL_* names are also accepted for compatibility)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-api-domain.onrender.com/api/webhook/gmail/auth/callback

# Gmail push notifications (optional; manual sync still works)
GOOGLE_PUBSUB_TOPIC=projects/your-project/topics/msme360-gmail
# Preferred: verify the Pub/Sub OIDC token against the exact push endpoint URL
GOOGLE_PUBSUB_AUDIENCE=https://your-api-domain.onrender.com/api/webhook/gmail
# Alternative for simple setups: a shared token appended as ?token=...
# GOOGLE_PUBSUB_TOKEN=replace-with-a-long-random-token

# Meta / WhatsApp / Messenger / Instagram
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=replace-with-a-long-random-verify-token
META_OAUTH_REDIRECT_URI=https://your-api-domain.onrender.com/api/integrations/meta/callback
META_GRAPH_VERSION=v22.0

# Optional legacy single-tenant WhatsApp fallback (not used for new connections)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Optional legacy email webhook (SendGrid/Mailgun); disabled unless set
# EMAIL_WEBHOOK_SECRET=replace-with-a-long-random-token

# Optional: extra allowed browser origins, comma-separated
# CORS_EXTRA_ORIGINS=https://admin.example.com
